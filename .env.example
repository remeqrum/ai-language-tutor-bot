# 🌍 Языковые настройки бота (Language Settings)
# NATIVE_LANGUAGE - Родной язык пользователя (на нем бот будет объяснять правила и давать комментарии)
NATIVE_LANGUAGE=Русский
# TARGET_LANGUAGE - Изучаемый язык (на нем нужно строить предложения)
TARGET_LANGUAGE=Словацкий
